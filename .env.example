# Postgres. Neon in production; any Postgres URL works locally and the
# driver is chosen from the hostname (see lib/db/index.ts).
#
#   Neon:  https://console.neon.tech  ->  new project  ->  copy the
#          "Connection string" (pooled). It looks like:
#          postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require
#
#   Local: docker run -d --name fraise-pg -e POSTGRES_PASSWORD=fraise \
#            -e POSTGRES_DB=fraise -p 55432:5432 postgres:16-alpine
#          postgresql://postgres:fraise@localhost:55432/fraise
DATABASE_URL=

# The /studio/ password. Any string; it is compared in constant time and
# never leaves the server. Generate one with:  openssl rand -base64 24
STUDIO_PASSWORD=

# Signs the studio session cookie. MUST be different from the password,
# and changing it logs everyone out.  openssl rand -base64 32
STUDIO_SECRET=

# Vercel Blob, for poster and video uploads in production. Create it in
# the Vercel dashboard: Storage -> Blob -> connect to the project. Vercel
# injects this automatically on deploy; you only need it here to test
# uploads locally against the real store.
# Leave EMPTY in local development and uploads go to public/media/ as
# they always have (see lib/studio/storage.ts).
BLOB_READ_WRITE_TOKEN=

# The public base URL of your Vercel Blob store, WITHOUT a trailing
# slash — e.g. https://abc123.public.blob.vercel-storage.com
# next.config.ts rewrites /media/:path* here for files that are not
# committed in public/. Leave empty locally.
BLOB_BASE_URL=

# Optional. A bearer token for the JSON write API (POST/PATCH/DELETE on
# /api/*). Reads are public and need nothing. Leave empty to disable
# token access entirely — the dashboard's own session still works.
#   openssl rand -base64 32
STUDIO_API_TOKEN=
