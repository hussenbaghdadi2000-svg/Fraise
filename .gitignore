# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. It carries no secrets and it is the only
# record of which variables the app needs to boot.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# screenshots from .claude/skills/fraise-frontend/scripts/shot.mjs
/shots/


# Vercel CLI project link. Holds the project and org id — not secret,
# but machine-specific, so it stays out of the repo.
.vercel
